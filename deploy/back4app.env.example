TRANSCRIPTION_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=replace_me
CLOUDFLARE_API_TOKEN=replace_me
MAX_VIDEO_DURATION_SECONDS=0
CLOUD_CHUNK_SECONDS=900
CLOUD_CHUNK_OVERLAP_SECONDS=3
CLOUDFLARE_REQUEST_TIMEOUT_SECONDS=600
CLOUDFLARE_INTER_CHUNK_DELAY_SECONDS=0.2
MAX_CONCURRENT_JOBS=1
RESULT_RETENTION_DAYS=10
CLEANUP_INTERVAL_HOURS=24
TRANSCRIPTION_CACHE_ENABLED=true
APP_ENV=production
