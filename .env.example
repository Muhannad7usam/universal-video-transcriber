APP_ENV=production
HOST=0.0.0.0
PORT=8000

# Adaptive defaults: GPU -> large-v3, CPU -> large-v3-turbo
WHISPER_MODEL=auto
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
WHISPER_BEAM_SIZE=3
WHISPER_VAD_MIN_SILENCE_MS=450
WHISPER_VAD_SPEECH_PAD_MS=220

# Long-form support.
# 0 = no application-level duration cap.
# Videos >= 1 hour are automatically processed in 30-minute bounded-memory
# chunks with a small overlap so multi-hour recordings do not need to fit in RAM.
MAX_VIDEO_DURATION_SECONDS=0
LONG_VIDEO_CHUNK_THRESHOLD_SECONDS=3600
LONG_VIDEO_CHUNK_SECONDS=1800
LONG_VIDEO_CHUNK_OVERLAP_SECONDS=3

# Keep one heavy inference job per machine by default for lowest per-video latency.
MAX_CONCURRENT_JOBS=1
MAX_PLAYLIST_ITEMS=100

RESULT_RETENTION_DAYS=10
CLEANUP_INTERVAL_HOURS=24
TRANSCRIPTION_CACHE_ENABLED=true
DATA_DIR=./data
LOG_LEVEL=INFO
